  skos:topConceptOf <http://cv.iptc.org/newscodes/mediatopic/> .

<http://cv.iptc.org/newscodes/mediatopic/16000000> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Conflit, guerre et paix"@fr ;
  skos:prefLabel "conflict, war and peace"@en-GB ;
