  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000802> .

<http://cv.iptc.org/newscodes/mediatopic/20000807> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "slavery"@en-GB ;
  skos:prefLabel "Esclavage"@fr ;
