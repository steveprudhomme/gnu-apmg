  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000822> .

<http://cv.iptc.org/newscodes/mediatopic/20000824> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "archery"@en-GB ;
  skos:prefLabel "Tir à l'arc"@fr ;
  skos:prefLabel "archery"@en-US ;
  skos:definition "Archers use bows and arrows to aim at targets, includes longbow and crossbow"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000822> .

<http://cv.iptc.org/newscodes/mediatopic/20000825> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "crossbow shooting"@en-GB ;
  skos:prefLabel "Tir à l'arbalète"@fr ;
