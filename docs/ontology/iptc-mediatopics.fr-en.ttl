  skos:prefLabel "Discipline"@fr ;
  skos:prefLabel "competitive sport"@en-GB ;
  skos:prefLabel "competitive sport"@en-US ;
  skos:definition "Sports and their disciplines executed in competitions"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/15000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000823> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "American football"@en-GB ;
  skos:prefLabel "Football américain"@fr ;
  skos:prefLabel "American football"@en-US ;
