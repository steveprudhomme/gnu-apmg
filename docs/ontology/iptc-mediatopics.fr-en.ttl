  skos:prefLabel "Sciences biomédicales"@fr ;
  skos:prefLabel "biomedical science"@en-GB ;
  skos:prefLabel "biomedical science"@en-US ;
  skos:definition "Application de la science basée sur la biologie à des domaines médicaux tels que la recherche, les contrôles de santé ou le traitement médical"@fr ;
  skos:definition "The application of biology-based science to medical fields such as research, health monitoring or medical treatment"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/13000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000711> a skos:Concept ;
