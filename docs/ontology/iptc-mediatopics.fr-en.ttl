  skos:prefLabel "Jaïnisme"@fr ;
  skos:prefLabel "Jainism"@en-US ;
  skos:definition "A religion beginning in the 7th-5th century BC in India that teaches a path to spiritual purity and enlightenment through a disciplined mode of life founded upon the tradition of ahimsa, nonviolence to all living creatures"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000679> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Judaïsme"@fr ;
  skos:prefLabel "Judaism"@en-GB ;
  skos:prefLabel "Judaism"@en-US ;
  skos:definition "A monotheistic religion and culture that follows the teachings of the Torah"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000680> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Animisme"@fr ;
  skos:prefLabel "nature religion"@en-GB ;
  skos:prefLabel "nature religion"@en-US ;
  skos:definition "Religions that believe nature and the natural world is an embodiment of divinity, sacredness or spiritual power, including indigenous religions practiced in various parts of the world, and modern Pagan faiths, such as Wicca"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000681> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Zoroastrianism"@en-GB ;
  skos:prefLabel "Parsasm"@fr ;
  skos:prefLabel "Zoroastrianism"@en-US ;
  skos:definition "A religion originating in ancient Iran following the teachings of the prophet Zoroaster, predicting the triumph of good over evil and exalting the benevolent deity of wisdom, Ahura Mazda (Wise Lord), as its supreme being"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000682> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Scientology"@en-GB ;
  skos:prefLabel "Scientologie"@fr ;
  skos:prefLabel "Scientology"@en-US ;
