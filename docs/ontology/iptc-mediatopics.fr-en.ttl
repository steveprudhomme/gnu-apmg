  skos:definition "A distinguishable type of music"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000018> .

<http://cv.iptc.org/newscodes/mediatopic/20000022> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Classique"@fr ;
  skos:prefLabel "classical music"@en-GB ;
  skos:prefLabel "classical music"@en-US ;
  skos:definition "Genre musical de tradition occidentale, comprenant la musique religieuse et profane, comme la symphonie, le concerto et la sonate"@fr ;
  skos:definition "A genre of music rooted in the traditions of Western music, including both religious and secular music, such as symphony, concerto and sonata."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000021> .

<http://cv.iptc.org/newscodes/mediatopic/20000023> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Country"@fr ;
  skos:prefLabel "country music"@en-GB ;
  skos:prefLabel "country music"@en-US ;
  skos:definition "Genre musical originaire du sud des États-Unis, souvent composé de ballades ou d'airs de danse et comportant des instruments à cordes tels que des banjos, des violons et des guitares"@fr ;
  skos:definition "A genre of music that originated in the southern United States, often consisting of ballads or dance tunes and featuring string instruments such as banjos, fiddles and guitars"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000021> .

<http://cv.iptc.org/newscodes/mediatopic/20000024> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Folk"@fr ;
  skos:prefLabel "folk music"@en-GB ;
  skos:prefLabel "folk music"@en-US ;
  skos:definition "Genre musical issu des cultures populaires traditionnelles, souvent basé sur des récits"@fr ;
  skos:definition "A genre of music that developed from traditional popular cultures, often based on story telling"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000021> .

<http://cv.iptc.org/newscodes/mediatopic/20000025> a skos:Concept ;
