  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000574> .

<http://cv.iptc.org/newscodes/mediatopic/20000586> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "voting"@en-GB ;
  skos:prefLabel "Opération de vote"@fr ;
  skos:prefLabel "voting"@en-US ;
