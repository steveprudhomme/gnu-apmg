  skos:prefLabel "Poésie"@fr ;
  skos:prefLabel "poetry"@en-US ;
  skos:definition "Œuvre écrite utilisant les qualités esthétiques et rythmiques du langage pour exprimer un message ou une émotion"@fr ;
  skos:definition "Written works that use the esthetic and rhythmic qualities of language to express a message or emotion"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000013> .

<http://cv.iptc.org/newscodes/mediatopic/20000018> a skos:Concept ;
