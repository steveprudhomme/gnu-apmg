  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000827> .

<http://cv.iptc.org/newscodes/mediatopic/20000834> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "hurdles"@en-GB ;
  skos:prefLabel "Course de haies"@fr ;
