  skos:definition "Musicians performing for an audience for the purpose of entertainment"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000018> .

<http://cv.iptc.org/newscodes/mediatopic/20000021> a skos:Concept ;
