  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000683> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Shintoïsme"@fr ;
  skos:prefLabel "Shintoism"@en-GB ;
  skos:prefLabel "Shintoism"@en-US ;
  skos:definition "An indigenous Japanese polytheistic religion that revolves around kami, supernatural entities believed to inhabit all things"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000684> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Sikhism"@en-GB ;
  skos:prefLabel "Sikhisme"@fr ;
  skos:prefLabel "Sikhism"@en-US ;
