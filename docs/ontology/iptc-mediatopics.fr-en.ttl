  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000802> .

<http://cv.iptc.org/newscodes/mediatopic/20000808> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Valeurs"@fr ;
  skos:prefLabel "values"@en-GB ;
  skos:prefLabel "values"@en-US ;
