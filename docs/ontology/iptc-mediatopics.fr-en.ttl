  skos:prefLabel "teenagers"@en-GB ;
  skos:prefLabel "teenagers"@en-US ;
  skos:definition "Young people between the ages that describe childhood and adulthood"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000788> .

<http://cv.iptc.org/newscodes/mediatopic/20000799> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "social condition"@en-GB ;
  skos:prefLabel "Condition sociale"@fr ;
  skos:prefLabel "social condition"@en-US ;
