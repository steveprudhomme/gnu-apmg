  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000827> .

<http://cv.iptc.org/newscodes/mediatopic/20000837> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "long jump"@en-GB ;
  skos:prefLabel "Saut en longueur"@fr ;
  skos:prefLabel "long jump"@en-US ;
  skos:definition "Competitors build up speed over a short sprint and then jump in one leap as far as possible"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000827> .

<http://cv.iptc.org/newscodes/mediatopic/20000838> a skos:Concept ;
