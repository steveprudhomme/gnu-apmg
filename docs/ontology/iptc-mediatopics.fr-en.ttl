  skos:definition "A form of performing art using instruments or voice to create different sounds, tones and harmonies"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000002> .

<http://cv.iptc.org/newscodes/mediatopic/20000019> a skos:Concept ;
