  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000811> .

<http://cv.iptc.org/newscodes/mediatopic/20000813> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Suicide"@fr ;
  skos:prefLabel "suicide"@en-GB ;
  skos:prefLabel "suicide"@en-US ;
  skos:definition "The intentional taking of one's own life"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000810> .

