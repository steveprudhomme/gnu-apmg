  skos:prefLabel "Génie mécanique"@fr ;
  skos:prefLabel "mechanical engineering"@en-GB ;
  skos:prefLabel "mechanical engineering"@en-US ;
  skos:definition "The study and application of the design, construction and operation of mechanical systems"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000756> .

<http://cv.iptc.org/newscodes/mediatopic/20000717> a skos:Concept ;
