  skos:prefLabel "Liberté de la presse"@fr ;
  skos:prefLabel "freedom of the press"@en-US ;
  skos:definition "The right of the press to report on stories freely and efforts by governments, organizations or individuals to suppress, jail or kill journalists who are reporting the news"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000587> .

<http://cv.iptc.org/newscodes/mediatopic/20000592> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Droits de l'homme"@fr ;
  skos:prefLabel "human rights"@en-GB ;
  skos:prefLabel "human rights"@en-US ;
  skos:definition "Rights entitled to be enjoyed by all people universally"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000587> .

<http://cv.iptc.org/newscodes/mediatopic/20000593> a skos:Concept ;
