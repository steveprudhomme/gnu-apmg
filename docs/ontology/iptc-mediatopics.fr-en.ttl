  skos:prefLabel "jazz music"@en-GB ;
  skos:prefLabel "Jazz"@fr ;
  skos:prefLabel "jazz music"@en-US ;
  skos:definition "Genre musical issu du blues et du ragtime qui est apparu dans les communautés afro-américaines de la Nouvelle-Orléans aux États-Unis à la fin du 19ème et au début du 20ème siècle"@fr ;
  skos:definition "A genre of music with roots in blues and ragtime that originated in African American communities of New Orleans in the United States in the late 19th and early 20th centuries"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000021> .

<http://cv.iptc.org/newscodes/mediatopic/20000026> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Pop"@fr ;
  skos:prefLabel "popular music"@en-GB ;
  skos:prefLabel "popular music"@en-US ;
  skos:definition "Genre musical largement accessible et conçu pour plaire à tous"@fr ;
  skos:definition "A genre of music that is widely accessible and designed to appeal to all"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000021> .

<http://cv.iptc.org/newscodes/mediatopic/20000027> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Rock"@fr ;
  skos:prefLabel "rock and roll music"@en-GB ;
  skos:prefLabel "rock and roll music"@en-US ;
  skos:definition "Genre musical originaire des États-Unis à la fin des années 1940 et au début des années 1950 évoluant à partir de styles musicaux afro-américains tels que le gospel, le jump blues, le jazz, le boogie woogie et le rhythm and blues"@fr ;
  skos:definition "A genre of music that originated in the United States during the late 1940s and early 1950s, evolving from African American musical styles such as gospel, jump blues, jazz, boogie woogie, and rhythm and blues."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000021> .

<http://cv.iptc.org/newscodes/mediatopic/20000028> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Opéra"@fr ;
  skos:prefLabel "opera"@en-GB ;
  skos:prefLabel "opera"@en-US ;
  skos:definition "Art du spectacle où des chanteurs et des musiciens de formation classique interprètent une œuvre musicale et théâtrale"@fr ;
  skos:definition "A form of performing art where classically trained musicians and singers perform a musical and dramatic work"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000029> .

<http://cv.iptc.org/newscodes/mediatopic/20000029> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Théâtre"@fr ;
  skos:prefLabel "theatre"@en-GB ;
  skos:prefLabel "theater"@en-US ;
  skos:definition "Art du spectacle où des comédiens interprètent une pièce sur scène devant un public à travers le dialogue et l'action"@fr ;
  skos:definition "A form of performing art where live performers portray a narrative to an audience through dialog and action"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000002> .

<http://cv.iptc.org/newscodes/mediatopic/20000030> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Théâtre musical"@fr ;
  skos:prefLabel "music theatre"@en-GB ;
  skos:prefLabel "music theater"@en-US ;
  skos:definition "Art du spectacle où les artistes interpètent une œuvre sur scène devant un public à travers la chanson, la danse, le dialogue et l'action"@fr ;
  skos:definition "A form of performing art where live performers portray a narrative to an audience through song, dialog and action, such as musicals and operettas"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000029> ;
  owl:deprecated true .

<http://cv.iptc.org/newscodes/mediatopic/20000031> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Arts visuels"@fr ;
  skos:prefLabel "visual arts"@en-GB ;
  skos:prefLabel "visual arts"@en-US ;
  skos:definition "Arts qui engagent principalement les sens visuels, tels que la céramique, le dessin, la peinture, la sculpture, la gravure, le design, l'artisanat, la photographie, la vidéo, le cinéma et l'architecture"@fr ;
  skos:definition "A form of art which appeals primarily to the visual senses, such as ceramics, drawing, painting, sculpture, printmaking, design, crafts, photography, video, filmmaking, and architecture."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000002> .

<http://cv.iptc.org/newscodes/mediatopic/20000032> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Architecture"@fr ;
  skos:prefLabel "architecture"@en-GB ;
  skos:prefLabel "architecture"@en-US ;
  skos:definition "Conception des bâtiments, des monuments et des espaces qui les entourent"@fr ;
  skos:definition "The design of buildings, monuments and the spaces around them"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000031> .

<http://cv.iptc.org/newscodes/mediatopic/20000033> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "design (visual arts)"@en-GB ;
  skos:prefLabel "Design"@fr ;
  skos:prefLabel "design (visual arts)"@en-US ;
  skos:definition "Discipline artistique axée sur la communication visuelle et la présentation, dont le produit final peut aller de la joaillerie à la décoration intérieure"@fr ;
  skos:definition "An artistic discipline which focuses on visual communication and presentation, the final product of which can range from jewelry to interior design"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000031> .

<http://cv.iptc.org/newscodes/mediatopic/20000034> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Dessin"@fr ;
  skos:prefLabel "drawing"@en-GB ;
  skos:prefLabel "drawing"@en-US ;
  skos:definition "Forme d'art visuel réalisé avec des outils tels que crayons, marqueurs, plume et encre, fusain"@fr ;
  skos:definition "A form of visual arts using mediums such as pencils, markers, pen and ink, charcoal"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000031> .

<http://cv.iptc.org/newscodes/mediatopic/20000035> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Peinture"@fr ;
  skos:prefLabel "painting"@en-GB ;
  skos:prefLabel "painting"@en-US ;
  skos:definition "Forme d'art visuel réalisé avec des matériaux tels que la peinture à l'huile, l'aquarelle, le pastel, le crayon"@fr ;
  skos:definition "A form of visual arts using mediums such as oil paint, watercolor, pastel, crayon"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000031> .

<http://cv.iptc.org/newscodes/mediatopic/20000036> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "photography"@en-GB ;
  skos:prefLabel "Photographie"@fr ;
  skos:prefLabel "photography"@en-US ;
  skos:definition "Forme d'art visuel qui consiste à produire des images en captant la lumière"@fr ;
  skos:definition "A form of visual arts using photographic images"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000031> .

<http://cv.iptc.org/newscodes/mediatopic/20000037> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "sculpture"@en-GB ;
  skos:prefLabel "Sculpture"@fr ;
  skos:prefLabel "sculpture"@en-US ;
  skos:definition "Forme d'art visuel réalisé avec des matériaux tels que l'argile, la pierre, le bois et le métal pour créer des œuvres en trois dimensions"@fr ;
  skos:definition "A form of visual arts using mediums such as clay, stone, wood and metal to create three-dimensional works"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000031> .

<http://cv.iptc.org/newscodes/mediatopic/20000038> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "culture"@en-GB ;
  skos:prefLabel "Culture"@fr ;
  skos:prefLabel "culture"@en-US ;
  skos:definition "Idées, coutumes, arts, traditions d'un groupe particulier de personnes"@fr ;
  skos:definition "The ideas, customs, arts, traditions of a particular group of persons"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/01000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000039> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "cultural development"@en-GB ;
  skos:prefLabel "Histoire de l'art"@fr ;
  skos:prefLabel "cultural development"@en-US ;
  skos:definition "Histoire du développement de l'art et de la culture comme l'évolution des peintures rupestres, les variations linguistiques dans le temps, l'évolution des valeurs socioculturelles"@fr ;
  skos:definition "The history of the development of art and culture such as the rise of cave paintings, linguistic variations over time, the evolution of values"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000038> .

<http://cv.iptc.org/newscodes/mediatopic/20000040> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "customs and tradition"@en-GB ;
  skos:prefLabel "Coutumes et traditions"@fr ;
  skos:prefLabel "customs and tradition"@en-US ;
  skos:definition "A particular way of behaving, or observances that have developed over time by a group of people"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000038> .

<http://cv.iptc.org/newscodes/mediatopic/20000041> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "festive event (culture)"@en-GB ;
  skos:prefLabel "Festivals et commémorations"@fr ;
  skos:prefLabel "festive event (culture)"@en-US ;
  skos:definition "Événement habituellement célébré par une communauté et centré sur un aspect caractéristique de cette communauté, de sa religion ou de ses traditions"@fr ;
  skos:definition "An event ordinarily celebrated by a community and centering on some characteristic aspect of that community and its religion or traditions"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000038> .

<http://cv.iptc.org/newscodes/mediatopic/20000042> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "language"@en-GB ;
  skos:prefLabel "Langue"@fr ;
  skos:prefLabel "language"@en-US ;
  skos:definition "Méthode de communication humaine, orale ou écrite, composée de mots utilisés de manière structurée et conventionnelle"@fr ;
  skos:definition "The method of human communication, either spoken or written, consisting of words that are used in a structured and conventional way"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000038> .

<http://cv.iptc.org/newscodes/mediatopic/20000043> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Bibliothèque et musée"@fr ;
  skos:prefLabel "library and museum"@en-GB ;
  skos:prefLabel "library and museum"@en-US ;
  skos:definition "Institution qui abrite des collections de livres, de musique, d'œuvres d'art ou d'objets du passé et du présent pouvant être exposées ou mises à la disposition du public"@fr ;
  skos:definition "Institutions that house collections of books, music, art, or objects from the past and present optionally for public use and display"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000038> .

<http://cv.iptc.org/newscodes/mediatopic/20000044> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Patrimoine"@fr ;
  skos:prefLabel "monument and heritage site"@en-GB ;
  skos:prefLabel "monument and heritage site"@en-US ;
  skos:definition "Biens et monuments commémorant des personnages ou des événements historiques et les sites qui les entourent"@fr ;
  skos:definition "Commemorations of historical people, events, or the areas containing them, in the form of structures such as sculptures, statues or buildings"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000038> .

<http://cv.iptc.org/newscodes/mediatopic/20000045> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "mass media"@en-GB ;
  skos:prefLabel "Médias"@fr ;
  skos:prefLabel "mass media"@en-US ;
  skos:definition "Médias s'adressant à une large audience"@fr ;
  skos:definition "Media addressing a large audience"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/01000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000046> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "news media"@en-GB ;
  skos:prefLabel "Média d'information"@fr ;
  skos:prefLabel "news media"@en-US ;
  skos:definition "Présentation d'informations au public à travers différentes plateformes, telles que la télévision, la radio, les journaux, les magazines et l'internet"@fr ;
  skos:definition "The presentation of news to the public through different platforms, such as TV, radio, newspapers, magazines, web pages and blogs"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000045> .

<http://cv.iptc.org/newscodes/mediatopic/20000047> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Journaux"@fr ;
  skos:prefLabel "newspaper"@en-GB ;
  skos:prefLabel "newspaper"@en-US ;
  skos:definition "Publication périodique qui présente des informations locales, régionales ou mondiales, ainsi que des sujets magazines, des reportages, des articles d'opinion, des bandes dessinées et d'autres contenus"@fr ;
  skos:definition "Daily or weekly publication that presents the news, locally, regionally or globally, as well as features, opinion columns, comics and other content"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000045> .

<http://cv.iptc.org/newscodes/mediatopic/20000048> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Internet"@fr ;
  skos:prefLabel "online media outlet"@en-GB ;
  skos:prefLabel "online media outlet"@en-US ;
  skos:definition "Média proposant des contenus multimédias sur Internet, tel que des nouvelles, des articles, des blogs, des photos, des infographies, des vidéos et de la musique"@fr ;
  skos:definition "Publication distributing content, such as articles, blogs, photos, video and music, only over the internet"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000045> .

<http://cv.iptc.org/newscodes/mediatopic/20000049> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Périodiques"@fr ;
  skos:prefLabel "periodical"@en-GB ;
  skos:prefLabel "periodical"@en-US ;
  skos:definition "Publication qui est généralement publiée chaque semaine, toutes les deux semaines, tous les mois ou tous les ans, comme les magazines, les revues et les bulletins d'information"@fr ;
  skos:definition "Publication that is usually published weekly, bi-weekly, monthly or annually, such as magazines, journals or newsletters"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000045> .

<http://cv.iptc.org/newscodes/mediatopic/20000050> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "radio"@en-GB ;
  skos:prefLabel "Radio"@fr ;
  skos:prefLabel "radio"@en-US ;
  skos:definition "Média proposant des contenus audio, tel que nouvelles, magazines ou émissions de divertissement, transmis par ondes ou par Internet"@fr ;
  skos:definition "Audio content, such as news, entertainment or information, distributed via broadcast or internet"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000045> .

<http://cv.iptc.org/newscodes/mediatopic/20000051> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Télévision"@fr ;
  skos:prefLabel "television"@en-GB ;
  skos:prefLabel "television"@en-US ;
  skos:definition "Média proposant des contenus audiovisuels, tel que nouvelles, magazines ou émissions de divertissement, transmis par ondes, câble ou Internet"@fr ;
  skos:definition "Video content, such as news, entertainment or information, distributed via broadcast or internet"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000045> .

<http://cv.iptc.org/newscodes/mediatopic/20000053> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Acte de terrorisme"@fr ;
  skos:prefLabel "act of terror"@en-GB ;
  skos:prefLabel "act of terror"@en-US ;
  skos:definition "Acte de violence, entraînant souvent des victimes, destiné à susciter la peur et l'anxiété dans une population"@fr ;
  skos:definition "Act of violence, often resulting in casualties, designed to raise fear and anxiety in a population"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/16000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000054> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "act of bioterrorism"@en-GB ;
  skos:prefLabel "Bioterrorisme"@fr ;
  skos:prefLabel "act of bioterrorism"@en-US ;
  skos:definition "Attaques où sont utilisés des agents biologiques, destinées à provoquer un effet de panique au sein d'une population"@fr ;
  skos:definition "Attacks using biological agents intended to raise the level of fear within a population"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000053> .

<http://cv.iptc.org/newscodes/mediatopic/20000055> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "terrorist bombings"@en-GB ;
  skos:prefLabel "Attentat à la bombe"@fr ;
  skos:prefLabel "terrorist bombings"@en-US ;
  skos:definition "Utilisation intentionnelle d'engins explosifs sur des personnes, des bâtiments ou d'autres structures"@fr ;
  skos:definition "Intentional use of explosive devices on people, buildings or other structures"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000053> .

<http://cv.iptc.org/newscodes/mediatopic/20000056> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Conflit armé"@fr ;
  skos:prefLabel "armed conflict"@en-GB ;
  skos:prefLabel "armed conflict"@en-US ;
  skos:definition "Conflits entre groupes opposés impliquant l'utilisation d'armes, pas nécessairement des guerres déclarées"@fr ;
  skos:definition "Disputes between opposing groups involving the use of weapons, but not necessarily formally declared wars"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/16000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000057> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "guerrilla activity"@en-GB ;
  skos:prefLabel "Guérilla"@fr ;
  skos:prefLabel "guerrilla activity"@en-US ;
  skos:definition "Actions antigouvernementales ou actions de guerre menées par des groupes de combattants clandestins ou indépendants, utilisant souvent des tactiques telles que l'embuscade, le sabotage, les raids et les enlèvements"@fr ;
  skos:definition "Anti-government or wartime actions by clandestine or non-state combatant groups, often using tactics such as ambush, sabotage, raids and kidnapping"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000056> .

<http://cv.iptc.org/newscodes/mediatopic/20000058> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Intervention militaire internationale"@fr ;
  skos:prefLabel "international military intervention"@en-GB ;
  skos:prefLabel "international military intervention"@en-US ;
  skos:definition "Présence temporaire de forces internationales dans un pays ou une région qui nécessite une aide extérieure pour résoudre une crise"@fr ;
  skos:definition "The temporary use of international forces in a country or region that requires outside help with resolving a crisis"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000056> .

<http://cv.iptc.org/newscodes/mediatopic/20000059> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Forces de maintien de la paix"@fr ;
  skos:prefLabel "peacekeeping force"@en-GB ;
  skos:prefLabel "peacekeeping force"@en-US ;
  skos:definition "Forces militaires d'une nation, ou de plusieurs nations travaillant ensemble, dont la mission est de maintenir la paix dans des zones de conflit"@fr ;
  skos:definition "The military forces of a nation, or of several nations working together, whose mission is to maintain peace in areas of conflict"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000073> .

<http://cv.iptc.org/newscodes/mediatopic/20000060> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Forces d'occupation"@fr ;
  skos:prefLabel "military occupation"@en-GB ;
  skos:prefLabel "military occupation"@en-US ;
  skos:definition "Invasion temporaire d'un pays ou d'une région par des forces militaires"@fr ;
  skos:definition "The temporary forceful taking over of a country or region by invading military forces"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000056> .

<http://cv.iptc.org/newscodes/mediatopic/20000061> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "missing in action"@en-GB ;
  skos:prefLabel "Disparus au combat"@fr ;
  skos:prefLabel "missing in action"@en-US ;
  skos:definition "Civils ou militaires qui ont disparu pendant ou après les hostilités, les conflits ou la guerre"@fr ;
  skos:definition "Civilians or military personnel who have gone missing during or after hostilities, conflicts or war"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20001377> .

<http://cv.iptc.org/newscodes/mediatopic/20000062> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "war"@en-GB ;
  skos:prefLabel "Guerre"@fr ;
  skos:prefLabel "war"@en-US ;
  skos:definition "Hostilités armées d'un groupe ou d'une entité géopolitique contre une autre"@fr ;
  skos:definition "Armed hostilities by one group or geopolitical entity against another"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000056> .

<http://cv.iptc.org/newscodes/mediatopic/20000063> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Guerre civile"@fr ;
  skos:prefLabel "civil war"@en-GB ;
  skos:prefLabel "civil war"@en-US ;
  skos:definition "Conflit armé entre membres d'un même pays, dans certains cas dans le but de diviser le pays"@fr ;
  skos:definition "Armed conflict between members of the same country, in some cases with the goal of dividing the country"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000062> .

<http://cv.iptc.org/newscodes/mediatopic/20000064> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Crime de guerre"@fr ;
  skos:prefLabel "war crime action"@en-GB ;
  skos:prefLabel "war crime action"@en-US ;
  skos:definition "Actions alleged as crimes committed during a war or armed conflict, usually against civilians or POWs"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000062> ;
  owl:deprecated true .

<http://cv.iptc.org/newscodes/mediatopic/20000065> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "civil unrest"@en-GB ;
  skos:prefLabel "Troubles civils"@fr ;
  skos:prefLabel "civil unrest"@en-US ;
  skos:definition "Rassemblements, grèves, manifestations, émeutes ou autres perturbations menées par une population, souvent pour protester contre les politiques ou les actions d'un gouvernement ou d'une autre organisation"@fr ;
  skos:definition "Rallies, strikes, demonstrations, riots or other disturbances by a population, often in protest to a government or other organization's policies or actions"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/16000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000066> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "protests and demonstrations"@en-GB ;
  skos:prefLabel "Manifestation"@fr ;
  skos:prefLabel "protests and demonstrations"@en-US ;
  skos:definition "Manifestation publique non-violente de soutien ou d'opposition à une cause, une idée ou une politique, sous la forme d'une réunion de masse ou d'une marche"@fr ;
  skos:definition "A non-violent public show of support for or opposition to a cause, idea or policy, in the form of a mass meeting or march"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000065> .

<http://cv.iptc.org/newscodes/mediatopic/20000067> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "rebellion"@en-GB ;
  skos:prefLabel "Rébellion"@fr ;
  skos:prefLabel "rebellion"@en-US ;
  skos:definition "Actions d'opposition à un gouvernement ou à un parti au pouvoir, souvent violentes, organisées par les résidents d'une nation dans le but de renverser le gouvernement"@fr ;
  skos:definition "Organized actions of opposition to a government or ruling party by a country's residents, often violent and with the aim of overthrowing the government"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000065> .

<http://cv.iptc.org/newscodes/mediatopic/20000068> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "revolution"@en-GB ;
  skos:prefLabel "Révolution"@fr ;
  skos:prefLabel "revolution"@en-US ;
  skos:definition "Changement par la force et souvent violent, ou renversement, du système de gouvernement ou de l'ordre social d'un pays par des forces internes, en faveur d'un nouveau système"@fr ;
  skos:definition "A forcible and often violent change to, or overthrow of, a country's political system or social order by internal forces, in favor of a new system"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000065> .

<http://cv.iptc.org/newscodes/mediatopic/20000069> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Emeutes"@fr ;
  skos:prefLabel "riot"@en-GB ;
  skos:prefLabel "riot"@en-US ;
  skos:definition "Troubles de l'ordre public provoqués par des groupes de personnes, en réponse à un grief ou pour faire acte d'opposition, provoquant souvent des violences, des blessures et des destructions de biens"@fr ;
  skos:definition "Violent, destructive events of civil disorder by groups of people, usually in response to a grievance or as acts of opposition, often involving injury to individuals and destruction of property"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000065> .

<http://cv.iptc.org/newscodes/mediatopic/20000070> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "coup d'etat"@en-GB ;
  skos:prefLabel "Coup d'Etat"@fr ;
  skos:prefLabel "coup d'etat"@en-US ;
  skos:definition "Renversement d'un gouvernement par un groupe militaire ou politique organisé"@fr ;
  skos:definition "The overthrow of an established government by an organized military or political group"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/16000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000071> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Massacre"@fr ;
  skos:prefLabel "massacre"@en-GB ;
  skos:prefLabel "massacre"@en-US ;
  skos:definition "Massacre de personnes, généralement des civils, pendant les hostilités en temps de guerre"@fr ;
  skos:definition "The mass killing of people, usually civilians, during wartime hostilities"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/16000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000072> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "genocide"@en-GB ;
  skos:prefLabel "Génocide"@fr ;
  skos:prefLabel "genocide"@en-US ;
  skos:definition "Assassinat systématique d'un clan, d'une tribu ou d'un groupe religieux ou ethnique"@fr ;
  skos:definition "The systematic killing of one clan, tribe, or religious or ethnic group by another"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000073> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "peace process"@en-GB ;
  skos:prefLabel "Processus de paix"@fr ;
  skos:prefLabel "peace process"@en-US ;
  skos:definition "Actions organisées pour mettre fin à une guerre ou à un conflit, impliquant généralement des négociations de paix et des accords"@fr ;
  skos:definition "Organized actions to end a war or conflict, usually involving peace negotiations and agreements"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/16000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000074> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Émissaire de la paix"@fr ;
  skos:prefLabel "peace envoy"@en-GB ;
  skos:prefLabel "peace envoy"@en-US ;
  skos:definition "Personne ou organisation initiant et menant un processus de paix"@fr ;
  skos:definition "Person or organization initiating and carrying out a peace process"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000073> .

<http://cv.iptc.org/newscodes/mediatopic/20000075> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "peace plan"@en-GB ;
  skos:prefLabel "Plan de paix"@fr ;
  skos:prefLabel "peace plan"@en-US ;
  skos:definition "Stratégie pour parvenir à la paix dans une nation belligérante ou dans une zone de conflit"@fr ;
  skos:definition "A strategy for achieving peace in a warring nation or area of conflict"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000073> .

<http://cv.iptc.org/newscodes/mediatopic/20000076> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Pourparlers de paix"@fr ;
  skos:prefLabel "peace talks"@en-GB ;
  skos:prefLabel "peace talks"@en-US ;
  skos:definition "Discussions entre pays, régions du monde ou entités géopolitiques en conflit ou en guerre, souvent menées avec un médiateur, dans le but d'arriver à une solution pour la paix"@fr ;
  skos:definition "Discussions between countries, world regions or geopolitical entities in conflict or at war, often with a mediator, with the goal of arriving at a solution for peace"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000073> .

<http://cv.iptc.org/newscodes/mediatopic/20000077> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "post-war reconstruction"@en-GB ;
  skos:prefLabel "Reconstruction"@fr ;
  skos:prefLabel "post-war reconstruction"@en-US ;
  skos:definition "Actions pour reconstruire une société, une économie ou un système politique dans une zone touchée par la guerre"@fr ;
  skos:definition "Actions to rebuild a society, economy or political system in an area affected by war"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/16000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000078> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Désarmement"@fr ;
  skos:prefLabel "disarmament"@en-GB ;
  skos:prefLabel "disarmament"@en-US ;
  skos:definition "Réduction ou destruction de la cache d'armes militaires d'une nation"@fr ;
  skos:definition "The abolishment or reduction of a country's military weapons cache"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000073> .

<http://cv.iptc.org/newscodes/mediatopic/20000079> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Déminage"@fr ;
  skos:prefLabel "ordnance clearance"@en-GB ;
  skos:prefLabel "ordnance clearance"@en-US ;
  skos:definition "Enlèvement ou neutralisation de munitions telles que les mines antipersonnel ou les bombes à sous-munitions qui peuvent subsister après une guerre ou un conflit armé sur un terrain public"@fr ;
  skos:definition "The removal or neutralization of ordnance such as landmines or cluster bombs that may remain after a war or armed conflict on public ground"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000077> .

<http://cv.iptc.org/newscodes/mediatopic/20000080> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "prisoners of war"@en-GB ;
  skos:prefLabel "Prisonniers de guerre"@fr ;
  skos:prefLabel "prisoners of war"@en-US ;
  skos:definition "Individus capturés, emprisonnés ou détenus par des factions ennemies pendant les conflits militaires ou la guerre"@fr ;
  skos:definition "Individuals captured, imprisoned or detained by enemy factions during military conflicts or war"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20001377> .

<http://cv.iptc.org/newscodes/mediatopic/20000082> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "crime"@en-GB ;
  skos:prefLabel "Criminalité"@fr ;
  skos:prefLabel "crime"@en-US ;
  skos:definition "Violations of laws by individuals, companies or organizations"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/02000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000083> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Incendie volontaire"@fr ;
  skos:prefLabel "arson"@en-GB ;
  skos:prefLabel "arson"@en-US ;
  skos:definition "The intentional setting of fires with criminal intent"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000084> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "assault"@en-GB ;
  skos:prefLabel "Agression"@fr ;
  skos:prefLabel "assault"@en-US ;
  skos:definition "Physical crime against a person, including battery, brawls and threat of bodily harm"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000085> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Agression sexuelle"@fr ;
  skos:prefLabel "sex crime"@en-GB ;
  skos:prefLabel "sex crime"@en-US ;
  skos:definition "Sexual crimes against a person, such as rape, harassment, molestation or groping"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000084> .

<http://cv.iptc.org/newscodes/mediatopic/20000086> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Piratage informatique"@fr ;
  skos:prefLabel "cyber crime"@en-GB ;
  skos:prefLabel "cyber crime"@en-US ;
  skos:definition "Criminal activities carried out by means of computers or the internet, such as hacking, phishing scams and identity theft"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000087> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "corporate crime"@en-GB ;
  skos:prefLabel "Délinquance financière"@fr ;
  skos:prefLabel "corporate crime"@en-US ;
  skos:definition "Crimes committed by a corporation or by individuals acting on behalf of a corporation"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000088> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "anti-trust crime"@en-GB ;
  skos:prefLabel "Infraction à la concurrence"@fr ;
  skos:prefLabel "anti-trust crime"@en-US ;
  skos:definition "Violations of laws aimed at corporations to promote fair competition for the benefit of consumers"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000087> .

<http://cv.iptc.org/newscodes/mediatopic/20000089> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "breach of contract"@en-GB ;
  skos:prefLabel "Violation de contrat"@fr ;
  skos:prefLabel "breach of contract"@en-US ;
  skos:definition "The breaking of terms set in a contractual agreement"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000087> .

<http://cv.iptc.org/newscodes/mediatopic/20000090> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Détournement de fonds"@fr ;
  skos:prefLabel "embezzlement"@en-GB ;
  skos:prefLabel "embezzlement"@en-US ;
  skos:definition "The intentional theft or misuse of money left in one's care or belonging to one's employer"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000087> .

<http://cv.iptc.org/newscodes/mediatopic/20000091> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Délit d'initié"@fr ;
  skos:prefLabel "insider trading"@en-GB ;
  skos:prefLabel "insider trading"@en-US ;
  skos:definition "Trading of stocks by persons having access to internal information not made public at the time"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000087> .

<http://cv.iptc.org/newscodes/mediatopic/20000092> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Infraction commerciale"@fr ;
  skos:prefLabel "restraint of trade"@en-GB ;
  skos:prefLabel "restraint of trade"@en-US ;
  skos:definition "Interference in free competition in business and trade"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000087> .

<http://cv.iptc.org/newscodes/mediatopic/20000093> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "corruption"@en-GB ;
  skos:prefLabel "Corruption"@fr ;
  skos:prefLabel "corruption"@en-US ;
  skos:definition "Dishonest actions by a person in power in return for pecuniary or personal gain"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000094> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "bribery"@en-GB ;
  skos:prefLabel "Subornation de témoins"@fr ;
  skos:prefLabel "bribery"@en-US ;
  skos:definition "The giving of money or favors in order to influence the judgment or conduct of a person in a position of power"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000093> .

<http://cv.iptc.org/newscodes/mediatopic/20000095> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "drug related crimes"@en-GB ;
  skos:prefLabel "Crimes liés aux stupéfiants"@fr ;
  skos:prefLabel "drug related crimes"@en-US ;
  skos:definition "Illegal activities involving illicit substances, including buying, distribution, selling and smuggling"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000096> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Trafic de drogue"@fr ;
  skos:prefLabel "drug trafficking"@en-GB ;
  skos:prefLabel "drug trafficking"@en-US ;
  skos:definition "Dealing in illicit often harmful substances"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000095> .

<http://cv.iptc.org/newscodes/mediatopic/20000097> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Fraude"@fr ;
  skos:prefLabel "fraud"@en-GB ;
  skos:prefLabel "fraud"@en-US ;
  skos:definition "Intentional deception for personal or financial gain"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000098> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Détournement"@fr ;
  skos:prefLabel "hijacking"@en-GB ;
  skos:prefLabel "hijacking"@en-US ;
  skos:definition "Taking over a transportation vehicle by force"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000099> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "homicide"@en-GB ;
  skos:prefLabel "Homicide"@fr ;
  skos:prefLabel "homicide"@en-US ;
  skos:definition "The killing of one person by another, including murder and manslaughter"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000100> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Enlèvement"@fr ;
  skos:prefLabel "kidnapping"@en-GB ;
  skos:prefLabel "kidnapping"@en-US ;
  skos:definition "To seize and detain a person against that person's will by unlawful threat, force or fraud"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000101> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "organised crime"@en-GB ;
  skos:prefLabel "Crime organisé"@fr ;
  skos:prefLabel "organized crime"@en-US ;
  skos:definition "Crimes committed by gangs or criminal organizations, such as the mafia"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000102> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "gang activity"@en-GB ;
  skos:prefLabel "Bandes criminelles"@fr ;
  skos:prefLabel "gang activity"@en-US ;
  skos:definition "Criminal activities by groups of individuals, who are allied by common territories, languages or ethnic backgrounds and identify by a common group identity by using a shared name, tattoo, hand sign, clothing style or graffiti symbol"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000101> .

<http://cv.iptc.org/newscodes/mediatopic/20000103> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "terrorism"@en-GB ;
  skos:prefLabel "Terrorisme"@fr ;
  skos:prefLabel "terrorism"@en-US ;
  skos:definition "Violence against people to create fear in order to achieve political or ideological objectives"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000104> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "robbery and theft"@en-GB ;
  skos:prefLabel "Vol"@fr ;
  skos:prefLabel "robbery and theft"@en-US ;
  skos:definition "The taking of another person's property without their consent, sometimes by force"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000105> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "war crime"@en-GB ;
  skos:prefLabel "Crime de guerre"@fr ;
  skos:prefLabel "war crime"@en-US ;
  skos:definition "Crimes committed during a war or armed conflict, usually against civilians or prisoners of war, including the prosecution of such crimes"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000082> .

<http://cv.iptc.org/newscodes/mediatopic/20000106> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Système judiciaire"@fr ;
  skos:prefLabel "judiciary"@en-GB ;
  skos:prefLabel "judiciary"@en-US ;
  skos:definition "The system of courts of law"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/02000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000107> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "court"@en-GB ;
  skos:prefLabel "Tribunal"@fr ;
  skos:prefLabel "court"@en-US ;
  skos:definition "Place where legal cases are heard and decided"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000106> .

<http://cv.iptc.org/newscodes/mediatopic/20000108> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Appel"@fr ;
  skos:prefLabel "appeal (court)"@en-GB ;
  skos:prefLabel "appeal (court)"@en-US ;
  skos:definition "Process in which parties request a formal change to an official decision"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000107> .

<http://cv.iptc.org/newscodes/mediatopic/20000109> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Greffe"@fr ;
  skos:prefLabel "court administration"@en-GB ;
  skos:prefLabel "court administration"@en-US ;
  skos:definition "Court clerks, bailiffs, stenographers etc."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000107> ;
  owl:deprecated true .

<http://cv.iptc.org/newscodes/mediatopic/20000110> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Juge"@fr ;
  skos:prefLabel "judge"@en-GB ;
  skos:prefLabel "judge"@en-US ;
  skos:definition "Official who decides cases in a court of law and passes sentences on those found guilty"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000107> .

<http://cv.iptc.org/newscodes/mediatopic/20000111> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "trial (court)"@en-GB ;
  skos:prefLabel "Procès"@fr ;
  skos:prefLabel "trial (court)"@en-US ;
  skos:definition "The process by which evidence is presented and guilt, innocence or culpability is determined"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000107> .

<http://cv.iptc.org/newscodes/mediatopic/20000112> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Audiences préliminaires"@fr ;
  skos:prefLabel "pre-trial"@en-GB ;
  skos:prefLabel "pre-trial"@en-US ;
  skos:definition "Actions that happen before the start of a trial, such as pleas, bail motions, discovery and depositions"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000111> .

<http://cv.iptc.org/newscodes/mediatopic/20000113> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "defendant"@en-GB ;
  skos:prefLabel "Accusé"@fr ;
  skos:prefLabel "defendant"@en-US ;
  skos:definition "The person on trial"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000111> ;
  owl:deprecated true .

<http://cv.iptc.org/newscodes/mediatopic/20000114> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Contentieux"@fr ;
  skos:prefLabel "litigation"@en-GB ;
  skos:prefLabel "litigation"@en-US ;
  skos:definition "Taking disputed issues to court for settlement by judge and/or jury"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000111> .

<http://cv.iptc.org/newscodes/mediatopic/20000115> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Témoin"@fr ;
  skos:prefLabel "witness"@en-GB ;
  skos:prefLabel "witness"@en-US ;
  skos:definition "A person who testifies"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000111> ;
  owl:deprecated true .

<http://cv.iptc.org/newscodes/mediatopic/20000116> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "out of court procedures"@en-GB ;
  skos:prefLabel "Procédures hors tribunal"@fr ;
  skos:prefLabel "out of court procedures"@en-US ;
  skos:definition "Legal issues which are settled outside of court"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000106> .

<http://cv.iptc.org/newscodes/mediatopic/20000117> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "arbitration and mediation"@en-GB ;
  skos:prefLabel "Arbitrage"@fr ;
  skos:prefLabel "arbitration and mediation"@en-US ;
  skos:definition "Resolution of disputed issues by a neutral panel, including conciliation, negotiation and tribunals"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000116> .

<http://cv.iptc.org/newscodes/mediatopic/20000118> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Accusation"@fr ;
  skos:prefLabel "prosecution and prosecutors"@en-GB ;
  skos:prefLabel "prosecution and prosecutors"@en-US ;
  skos:definition "The process of holding a trial against a person or entity who is accused of a crime to determine guilt and the lawyers and legal team who argue that the accused is guilty"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000106> .

<http://cv.iptc.org/newscodes/mediatopic/20000119> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Droits juridiques"@fr ;
  skos:prefLabel "justice"@en-GB ;
  skos:prefLabel "justice"@en-US ;
  skos:definition "The equitable administration of laws and regulations"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/02000000> ;
  owl:deprecated true .

<http://cv.iptc.org/newscodes/mediatopic/20000120> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "civil rights"@en-GB ;
  skos:prefLabel "Droits civiques"@fr ;
  skos:prefLabel "civil rights"@en-US ;
  skos:definition "Guarantees of protection to individuals  freedom from violation by governments, political and social organizations, and other individuals as determined by the laws or constitutions of an individual country"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000587> .

<http://cv.iptc.org/newscodes/mediatopic/20000121> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "law"@en-GB ;
  skos:prefLabel "Lois"@fr ;
  skos:prefLabel "law"@en-US ;
  skos:definition "The codification of rules of behavior"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/02000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000122> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "civil law"@en-GB ;
  skos:prefLabel "Droit civil"@fr ;
  skos:prefLabel "civil law"@en-US ;
  skos:definition "The system of law focused on private rights and disputes between individuals in such areas as contracts, torts, property, and family law"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000121> .

<http://cv.iptc.org/newscodes/mediatopic/20000123> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "antitrust regulations"@en-GB ;
  skos:prefLabel "Droit de la concurrence"@fr ;
  skos:prefLabel "antitrust regulations"@en-US ;
  skos:definition "laws to promote competition between companies for the benefit of consumers"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000124> .

<http://cv.iptc.org/newscodes/mediatopic/20000124> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Réglementation"@fr ;
  skos:prefLabel "regulations"@en-GB ;
  skos:prefLabel "regulations"@en-US ;
  skos:definition "laws that guide the conduct and organization of business corporations"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000122> .

<http://cv.iptc.org/newscodes/mediatopic/20000125> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Droit pénal"@fr ;
  skos:prefLabel "criminal law"@en-GB ;
  skos:prefLabel "criminal law"@en-US ;
  skos:definition "The system of law concerned with the punishment of those who commit crimes"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000121> .

<http://cv.iptc.org/newscodes/mediatopic/20000126> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Droit international"@fr ;
  skos:prefLabel "international law"@en-GB ;
  skos:prefLabel "international law"@en-US ;
  skos:definition "The system of laws embraced by all nations, such as the Geneva Convention and the International Law of the Seas"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000121> .

<http://cv.iptc.org/newscodes/mediatopic/20000127> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "extradition"@en-GB ;
  skos:prefLabel "Extradition"@fr ;
  skos:prefLabel "extradition"@en-US ;
  skos:definition "Legal transfer of criminals or suspects between countries"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000126> .

<http://cv.iptc.org/newscodes/mediatopic/20000128> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Cour ou tribunal international"@fr ;
  skos:prefLabel "international court and tribunal"@en-GB ;
  skos:prefLabel "international court and tribunal"@en-US ;
  skos:definition "The activities of courts under the authority of international organizations or formed by treaties between nations, such as the European Court for Human Rights and International Court of Justice"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000126> .

<http://cv.iptc.org/newscodes/mediatopic/20000129> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Forces de l'ordre"@fr ;
  skos:prefLabel "law enforcement"@en-GB ;
  skos:prefLabel "law enforcement"@en-US ;
  skos:definition "Agencies that attempt to prevent disobedience to established laws or bring to justice those who disobey those laws"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/02000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000130> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "arrest"@en-GB ;
  skos:prefLabel "Arrestation"@fr ;
  skos:prefLabel "arrest"@en-US ;
  skos:definition "The detention of a suspect of a crime"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000129> .

<http://cv.iptc.org/newscodes/mediatopic/20000131> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "investigation (criminal)"@en-GB ;
  skos:prefLabel "Enquête"@fr ;
  skos:prefLabel "investigation (criminal)"@en-US ;
  skos:definition "Inquiry into an alleged crime, including searching, interviews, interrogations and evidence collection"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000129> .

<http://cv.iptc.org/newscodes/mediatopic/20000132> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "missing person"@en-GB ;
  skos:prefLabel "Personne disparue"@fr ;
  skos:prefLabel "missing person"@en-US ;
  skos:definition "An adult whose disappearance is possibly not voluntary, or a child whose whereabouts are unknown to the child's legal guardian"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000131> .

<http://cv.iptc.org/newscodes/mediatopic/20000133> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Police"@fr ;
  skos:prefLabel "police"@en-GB ;
  skos:prefLabel "police"@en-US ;
  skos:definition "Civil force of a national, regional or local government that is responsible for the prevention and detection of crime and the maintenance of public order"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000129> .

<http://cv.iptc.org/newscodes/mediatopic/20000134> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "sentencing (criminal)"@en-GB ;
  skos:prefLabel "Peines"@fr ;
  skos:prefLabel "sentencing (criminal)"@en-US ;
  skos:definition "The retribution handed out to those who break laws"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000111> .

<http://cv.iptc.org/newscodes/mediatopic/20000135> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Peine capitale"@fr ;
  skos:prefLabel "capital punishment"@en-GB ;
  skos:prefLabel "capital punishment"@en-US ;
  skos:definition "The legally authorized execution of someone as punishment for a crime"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000134> .

<http://cv.iptc.org/newscodes/mediatopic/20000136> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "fine (penalty)"@en-GB ;
  skos:prefLabel "Amende"@fr ;
  skos:prefLabel "fine (penalty)"@en-US ;
  skos:definition "Money that a court of law or other authority decides has to be paid as punishment for a crime or other offence"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000134> .

<http://cv.iptc.org/newscodes/mediatopic/20000137> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Prison"@fr ;
  skos:prefLabel "prison"@en-GB ;
  skos:prefLabel "prison"@en-US ;
  skos:definition "Facility where people are held as a punishment for a crime they have committed or while awaiting trial"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000134> .

<http://cv.iptc.org/newscodes/mediatopic/20000139> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "accident and emergency incident"@en-GB ;
  skos:prefLabel "Accident"@fr ;
  skos:prefLabel "accident and emergency incident"@en-US ;
  skos:definition "A sudden, unexpected event that causes unwanted consequences or requires immediate action"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/03000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000140> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Explosion accidentelle"@fr ;
  skos:prefLabel "explosion accident and incident"@en-GB ;
  skos:prefLabel "explosion accident and incident"@en-US ;
  skos:definition "Explosions caused by an accidental, non-combat, or non-terrorism source. Also use when the source of the explosion is non-specified or unknown"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000139> .

<http://cv.iptc.org/newscodes/mediatopic/20000141> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "industrial accident and incident"@en-GB ;
  skos:prefLabel "Accident industriel"@fr ;
  skos:prefLabel "industrial accident and incident"@en-US ;
  skos:definition "Any unplanned event or mishap in an industrial setting that result in injuries to people and damage to property or the environment"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000139> .

<http://cv.iptc.org/newscodes/mediatopic/20000142> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "nuclear accident and incident"@en-GB ;
  skos:prefLabel "Accident nucléaire"@fr ;
  skos:prefLabel "nuclear accident and incident"@en-US ;
  skos:definition "Any unplanned event that causes unwanted consequences involving radioactive materials"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000141> .

<http://cv.iptc.org/newscodes/mediatopic/20000143> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "transportation accident and incident"@en-GB ;
  skos:prefLabel "Accident de transport"@fr ;
  skos:prefLabel "transportation accident and incident"@en-US ;
  skos:definition "An accident or incident involving one or more vehicles"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000139> .

<http://cv.iptc.org/newscodes/mediatopic/20000144> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "air and space accident and incident"@en-GB ;
  skos:prefLabel "Accident aérospatial"@fr ;
  skos:prefLabel "air and space accident and incident"@en-US ;
  skos:definition "An accident or incident involving aircrafts or spacecrafts"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000143> .

<http://cv.iptc.org/newscodes/mediatopic/20000145> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "maritime accident and incident"@en-GB ;
  skos:prefLabel "Accident maritime"@fr ;
  skos:prefLabel "maritime accident and incident"@en-US ;
  skos:definition "An accident or incident involving marine vessels."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000143> .

<http://cv.iptc.org/newscodes/mediatopic/20000146> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Accident ferroviaire"@fr ;
  skos:prefLabel "railway accident and incident"@en-GB ;
  skos:prefLabel "railway accident and incident"@en-US ;
  skos:definition "An accident or incident involving trains."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000143> .

<http://cv.iptc.org/newscodes/mediatopic/20000147> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Accident routier"@fr ;
  skos:prefLabel "road accident and incident"@en-GB ;
  skos:prefLabel "road accident and incident"@en-US ;
  skos:definition "An accident or incident involving road vehicles."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000143> .

<http://cv.iptc.org/newscodes/mediatopic/20000148> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Désastres"@fr ;
  skos:prefLabel "disaster"@en-GB ;
  skos:prefLabel "disaster"@en-US ;
  skos:definition "A sudden, unplanned event that causes great damage or loss of life, such as an accident or a natural catastrophe"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/03000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000149> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Famine"@fr ;
  skos:prefLabel "famine"@en-GB ;
  skos:prefLabel "famine"@en-US ;
  skos:definition "Severe lack of food for a large population"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000148> .

<http://cv.iptc.org/newscodes/mediatopic/20000150> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "fire"@en-GB ;
  skos:prefLabel "Incendie"@fr ;
  skos:prefLabel "fire"@en-US ;
  skos:definition "Fires started by an accidental or unknown source. For wildfires, use wildfire. For fires started with a criminal intent, use arson."@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000148> .

<http://cv.iptc.org/newscodes/mediatopic/20000151> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Catastrophe naturelle"@fr ;
  skos:prefLabel "natural disaster"@en-GB ;
  skos:prefLabel "natural disaster"@en-US ;
  skos:definition "Destructive incidents caused by nature, such as earthquakes and floods"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000148> .

<http://cv.iptc.org/newscodes/mediatopic/20000152> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Sécheresse"@fr ;
  skos:prefLabel "drought"@en-GB ;
  skos:prefLabel "drought"@en-US ;
  skos:definition "A severe lack of water over a period of time"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000151> .

<http://cv.iptc.org/newscodes/mediatopic/20000153> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "earthquake"@en-GB ;
  skos:prefLabel "Tremblement de terre"@fr ;
  skos:prefLabel "earthquake"@en-US ;
  skos:definition "The shifting of the tectonic plates of the Earth, creating in some cases damage to structures"@en-US ;
