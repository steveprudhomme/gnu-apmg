  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000685> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "Taoism"@en-GB ;
  skos:prefLabel "Taoïsme"@fr ;
  skos:prefLabel "Taoism"@en-US ;
  skos:definition "A philosophical and spiritual tradition originating in the 4th century BCE in China which emphasizes living in harmony with the Tao, the source, pattern and substance of everything that exists"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000657> .

<http://cv.iptc.org/newscodes/mediatopic/20000686> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
