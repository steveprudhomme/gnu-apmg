  skos:definition "The sciences that deal with matter, energy and the physical world, including physics, biology, chemistry and astronomy"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/13000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000718> a skos:Concept ;
