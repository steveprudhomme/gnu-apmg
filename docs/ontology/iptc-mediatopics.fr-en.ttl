  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000827> .

<http://cv.iptc.org/newscodes/mediatopic/20000831> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "hammer throw"@en-GB ;
