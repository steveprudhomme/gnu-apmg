  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000574> .

<http://cv.iptc.org/newscodes/mediatopic/20000587> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "fundamental rights"@en-GB ;
  skos:prefLabel "Droits fondamentaux"@fr ;
  skos:prefLabel "fundamental rights"@en-US ;
  skos:definition "The political, social, cultural and economic rights to which all people are entitled, usually upheld by law"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/14000000> .

<http://cv.iptc.org/newscodes/mediatopic/20000588> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "censorship and freedom of speech"@en-GB ;
  skos:prefLabel "Censure"@fr ;
  skos:prefLabel "censorship and freedom of speech"@en-US ;
  skos:definition "The right to express opinions without restraint and attempts to supress speech by an organization or individual"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000587> .

<http://cv.iptc.org/newscodes/mediatopic/20000590> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
  skos:prefLabel "freedom of religion"@en-GB ;
  skos:prefLabel "Liberté de religion"@fr ;
  skos:prefLabel "freedom of religion"@en-US ;
  skos:definition "The right to practice the religion of one's choosing and efforts to violate this right through the intimidation of believers or laws that encroach on religious rituals"@en-US ;
  skos:broader <http://cv.iptc.org/newscodes/mediatopic/20000587> .

<http://cv.iptc.org/newscodes/mediatopic/20000591> a skos:Concept ;
  skos:inScheme <http://cv.iptc.org/newscodes/mediatopic/> ;
