  skos:definition "Acts of socially or politically motivated protest or violence, military activities, geopolitical conflicts, as well as resolution efforts"@en-US ;
  skos:topConceptOf <http://cv.iptc.org/newscodes/mediatopic/> .

<http://cv.iptc.org/newscodes/mediatopic/17000000> a skos:Concept ;
