{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GNU APMG Phase 2 suggested observation v1",
  "type": "object",
  "required": ["observation_id", "photo_id", "type", "origin", "literal", "status", "confidence", "created_at", "tool_name", "tool_version", "model_digest", "derivative_sha256"],
  "properties": {
    "observation_id": {"type": "string", "format": "uuid"},
    "photo_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "type": {"enum": ["description", "object", "text"]},
    "origin": {"enum": ["model", "ocr"]},
    "literal": {"type": "string", "maxLength": 4000},
    "status": {"const": "suggested"},
    "confidence": {"type": "null"},
    "created_at": {"type": "string", "format": "date-time"},
    "tool_name": {"enum": ["Ollama", "PaddleOCR"]},
    "tool_version": {"type": "string", "minLength": 1},
    "model_name": {"type": "string"},
    "model_digest": {"type": "string", "minLength": 64},
    "prompt_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "derivative_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_score": {"type": "number", "minimum": 0, "maximum": 1},
    "polygon": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}},
    "coordinate_space": {"const": "derivative_pixels"}
  },
  "additionalProperties": false
}
